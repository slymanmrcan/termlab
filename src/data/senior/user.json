    {
      "id": "susr-001",
      "type": "single",
      "scenario": "UID degeri 0 olan tum hesaplari listele.",
      "steps": [
        {
          "prompt": "$ ",
          "answer": "awk -F: '$3 == 0 {print $1}' /etc/passwd",
          "hint_text": "Root yetkisine sahip hesaplari passwd verisinden filtrele.",
          "hint_partial": "awk -F: ... /etc/passwd"
        }
      ]
    },
    {
      "id": "susr-002",
      "type": "single",
      "scenario": "Sistemde sahibi veya grubu bulunamayan dosyalari tara.",
      "steps": [
        {
          "prompt": "$ ",
          "answer": "find / -nouser -o -nogroup 2>/dev/null",
          "hint_text": "Eski veya silinmis hesap artigini bulmak icin `find` audit'i yap.",
          "hint_partial": "find / ..."
        }
      ]
    },
    {
      "id": "susr-003",
      "type": "single",
      "scenario": "Interaktif shell'i olan tum hesaplari listele.",
      "steps": [
        {
          "prompt": "$ ",
          "answer": "awk -F: '$7 !~ /(nologin|false)$/ {print $1 \":\" $7}' /etc/passwd",
          "hint_text": "Gercek login shell kullanan hesaplari passwd alanlari uzerinden ayikla.",
          "hint_partial": "awk -F: ... /etc/passwd"
        }
      ]
    },
